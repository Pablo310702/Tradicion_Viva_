# Copia como .env.staging y cambia todos los valores CHANGE_ME.
# Nunca reutilices secretos, base de datos o almacenamiento de produccion.
APP_ENV_FILE=.env.staging

DOMAIN=staging.example.com
TLS_EMAIL=admin@example.com
CADDY_SITES=staging.example.com

DEBUG=False
SECRET_KEY=CHANGE_ME_staging_secret
JWT_SECRET_KEY=CHANGE_ME_staging_jwt_secret
ALLOWED_HOSTS=staging.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://staging.example.com,http://localhost:9000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

GUNICORN_WORKERS=4
GUNICORN_THREADS=2

POSTGRES_DB=tradicion_viva_staging
POSTGRES_USER=tradicion_viva_staging
POSTGRES_PASSWORD=CHANGE_ME_staging_database_password
DATABASE_URL=postgres://tradicion_viva_staging:CHANGE_ME_staging_database_password@db:5432/tradicion_viva_staging
DATABASE_SSL_REQUIRE=False

REDIS_PASSWORD=CHANGE_ME_staging_redis_password
REDIS_URL=redis://:CHANGE_ME_staging_redis_password@redis:6379/0

MEDIA_STORAGE_BACKEND=filesystem
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
AWS_QUERYSTRING_AUTH=False
AWS_QUERYSTRING_EXPIRE=3600

TRACCAR_SERVER_URL=
TRACCAR_API_TOKEN=
