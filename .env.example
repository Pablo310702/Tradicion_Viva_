# Copia este archivo como .env o ejecuta: python configurar_local.py
SECRET_KEY=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_LARGA
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Producción: usa DEBUG=False, tu dominio real y HTTPS.
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/base
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False

# Seguimiento GPS (opcional). Estas credenciales son globales.
# El ID de cada dispositivo se configura en Django Admin > Hermandades y cofradías.
# API web de Traccar. Si Traccar Client usa http://demo.traccar.org:5055,
# aquí corresponde https://demo.traccar.org (sin :5055).
TRACCAR_BASE_URL=https://demo.traccar.org
# Usa el correo y contraseña de la MISMA cuenta de Traccar donde registraste el dispositivo.
TRACCAR_USERNAME=
TRACCAR_PASSWORD=

# Correo SMTP para recuperación de contraseñas y comunicados masivos
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=usuario@example.com
EMAIL_HOST_PASSWORD=cambia-esta-clave
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=TRADICIÓN VIVA <usuario@example.com>

# ============================================================
# COMUNICACIONES AUTOMÁTICAS: SMS + WHATSAPP
# ============================================================
# Los teléfonos locales de 8 dígitos se convertirán a +502XXXXXXXX.
DEFAULT_PHONE_COUNTRY_CODE=+502
MESSAGING_HTTP_TIMEOUT=15
# En producción coloca la URL pública HTTPS del sistema, sin slash final.
# Se usa para recibir estados de entrega de Twilio.
PUBLIC_BASE_URL=

# SMS con Twilio Programmable Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# En producción puedes usar API Key en lugar del Auth Token:
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Configura UNO de los siguientes remitentes:
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Opcional. Si queda vacío se genera desde PUBLIC_BASE_URL.
TWILIO_STATUS_CALLBACK_URL=
TWILIO_VALIDATE_WEBHOOKS=True

# WhatsApp Business Cloud API de Meta
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Plantilla sugerida y aprobada en Meta:
# Cuerpo: Hola {{1}},\n\n{{2}}\n\nTRADICIÓN VIVA
WHATSAPP_DEFAULT_TEMPLATE_NAME=tradicion_viva_comunicado
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=es
# Webhook de Meta: crea un token de verificación propio y copia el App Secret.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
