# Copia este archivo como .env.production y reemplaza todos los valores CHANGE_ME.
# No subas .env.production al repositorio.

DOMAIN=tradicionviva.com
TLS_EMAIL=admin@tradicionviva.com
CADDY_SITES=tradicionviva.com,www.tradicionviva.com,rosario.tradicionviva.com,san-jose.tradicionviva.com,perdon.tradicionviva.com,soledad.tradicionviva.com,venerada.tradicionviva.com,calvario.tradicionviva.com

DEBUG=False
SECRET_KEY=CHANGE_ME_generate_a_long_random_secret
JWT_SECRET_KEY=CHANGE_ME_generate_a_different_long_random_secret
ALLOWED_HOSTS=tradicionviva.com,.tradicionviva.com
CSRF_TRUSTED_ORIGINS=https://tradicionviva.com,https://*.tradicionviva.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

POSTGRES_DB=tradicion_viva
POSTGRES_USER=tradicion_viva
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
DATABASE_URL=postgres://tradicion_viva:CHANGE_ME_strong_database_password@db:5432/tradicion_viva
DATABASE_SSL_REQUIRE=False

REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379/0

MEDIA_STORAGE_BACKEND=s3
AWS_STORAGE_BUCKET_NAME=CHANGE_ME_bucket
AWS_ACCESS_KEY_ID=CHANGE_ME_access_key
AWS_SECRET_ACCESS_KEY=CHANGE_ME_secret_key
AWS_S3_ENDPOINT_URL=https://CHANGE_ME_s3_endpoint
AWS_S3_REGION_NAME=auto
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600

TRACCAR_SERVER_URL=
TRACCAR_API_TOKEN=
